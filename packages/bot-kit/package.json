{
  "name": "@raspberry-varg/bot-kit",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./discord": {
      "types": "./dist/discord/index.d.ts",
      "bun": "./src/discord/index.ts",
      "default": "./dist/discord/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p ./tsconfig.build.json",
    "prepack": "rm -rf ./dist/** && pnpm run build"
  },
  "devDependencies": {
    "@raspberry-varg/config": "workspace:*",
    "@types/bun": "catalog:",
    "discord.js": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
