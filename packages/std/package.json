{
  "name": "@raspberryvarg/std",
  "version": "1.0.2",
  "private": false,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assertions": {
      "types": "./dist/assertions/index.d.ts",
      "default": "./dist/assertions/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "default": "./dist/math/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p ./tsconfig.build.json",
    "prepack": "rm -rf ./dist/** && pnpm run build"
  },
  "devDependencies": {
    "@raspberryvarg/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
